---
layout: layouts/base.njk
title: Work
description: WPF, video-processing and drone-data projects built at work.
---
{%- set items = projects | hasType("work") -%}
<div class="page-head">
  <div class="container">
    <p class="page-head__label">what i've shipped at work</p>
    <h1 class="page-head__title">Work</h1>
    <p class="page-head__intro">Projects built at work. Each detail page has what I did and related notes.</p>
  </div>
</div>
<div class="container">
  <div class="project-list">
    {%- for p in items -%}
      {%- set c = p.en -%}
      <article class="project-row" data-href="/en/work/{{ p.slug }}/" tabindex="0" role="link" aria-label="{{ c.title }}">
        <span class="project-row__num mono-font">{{ "0" if loop.index < 10 else "" }}{{ loop.index }}</span>
        <div class="project-row__info">
          <div class="project-row__name"><a href="/en/work/{{ p.slug }}/">{{ c.title }}</a></div>
          <div class="project-row__desc">{{ c.summary }}</div>
          <div class="project-row__tags">{%- for t in p.stack -%}<span class="tag tag-gray">{{ t }}</span>{%- endfor -%}</div>
        </div>
        <div class="project-row__meta">
          <span class="project-row__year mono-font">{{ p.period }}</span>
          <span class="status status-{{ p.status }}">{{ {active:"active",wip:"in progress",archived:"archived"}[p.status] }}</span>
        </div>
      </article>
    {%- endfor -%}
  </div>
</div>
